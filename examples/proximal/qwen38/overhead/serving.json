{
  "app_name": "miles-qwen38-serving",
  "image": "radixark/miles@sha256:e4fcc8c4d40ddd2fe3cbd46cfc414287d879b55cf9915250f6e5474f7c7462b9",
  "gpu": "B300",
  "tensor_parallel": 1,
  "routing_region": "us-west",
  "min_replicas": 8,
  "max_replicas": 8,
  "target_concurrency": 8,
  "scaledown_window_seconds": 600,
  "startup_timeout_seconds": 3600,
  "base_volume": {
    "volume_name": "miles-qwen38-base",
    "environment_name": "main"
  },
  "base_mount": "/models",
  "adapter_mount": "/adapters",
  "local_cache": "/cache",
  "max_loaded_adapters": 4,
  "gateway_secret": "miles-qwen38-gateway",
  "gateway_key_env": "MILES_GATEWAY_KEY",
  "capture_secret": "miles-platform",
  "cpu": 16,
  "memory_mib": 65536,
  "modal_proxy_auth": false,
  "attention": {
    "backend": "trtllm_mha",
    "page_size": 64
  },
  "speculative": {
    "algorithm": "NEXTN",
    "num_steps": 3,
    "num_draft_tokens": 4
  },
  "kv_cache_dtype": "fp8_e4m3",
  "extra_engine_args": [
    "--mem-fraction-static",
    "0.85",
    "--chunked-prefill-size",
    "2048"
  ]
}
