{
  "app_name": "miles-deepswe-features-001",
  "image": "radixark/miles@sha256:REPLACE_WITH_THE_MILES_IMAGE_DIGEST_THE_TRAINER_USES_0000000000",
  "gpu": "H100:2",
  "tensor_parallel": 2,
  "routing_region": "us-west",
  "min_replicas": 8,
